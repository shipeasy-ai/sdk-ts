{
  "name": "@shipeasy/sdk",
  "version": "9.0.0",
  "description": "Shipeasy SDK \u2014 feature gates, runtime configs, experiments, and metrics for the Shipeasy hosted service.",
  "license": "SEE LICENSE IN LICENSE",
  "homepage": "https://shipeasy.ai",
  "repository": {
    "type": "git",
    "url": "https://github.com/shipeasy-ai/sdk-ts.git"
  },
  "bugs": {
    "url": "https://github.com/shipeasy-ai/sdk-ts/issues"
  },
  "main": "./dist/server/index.js",
  "module": "./dist/server/index.mjs",
  "browser": "./dist/client/index.js",
  "react-native": "./dist/client/index.js",
  "typesVersions": {
    "*": {
      "client": [
        "./dist/client/index.d.ts"
      ],
      "server": [
        "./dist/server/index.d.ts"
      ],
      "devtools-contract": [
        "./dist/devtools-contract/index.d.ts"
      ]
    }
  },
  "exports": {
    ".": {
      "react-native": "./dist/client/index.js",
      "node": "./dist/server/index.js",
      "browser": "./dist/client/index.js",
      "default": "./dist/server/index.js"
    },
    "./server": {
      "types": "./dist/server/index.d.ts",
      "import": "./dist/server/index.mjs",
      "default": "./dist/server/index.js"
    },
    "./client": {
      "types": "./dist/client/index.d.ts",
      "default": "./dist/client/index.js"
    },
    "./devtools-contract": {
      "types": "./dist/devtools-contract/index.d.ts",
      "import": "./dist/devtools-contract/index.mjs",
      "default": "./dist/devtools-contract/index.js"
    }
  },
  "bin": {
    "shipeasy-skill": "./dist/skill-cli.js"
  },
  "files": [
    "dist/server/",
    "dist/client/",
    "dist/devtools-contract/",
    "dist/skill-cli.js",
    "docs/skill/SKILL.md",
    "LICENSE",
    "README.md"
  ],
  "scripts": {
    "build": "tsup",
    "type-check": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "gen:readme": "node scripts/gen-readme.mjs",
    "publish-loader": "wrangler r2 object put shipeasy-sdk/loader-v$npm_package_version.js --file=dist/loader/loader.global.js --content-type 'application/javascript; charset=utf-8' --cache-control 'public, max-age=31536000, immutable' --remote && wrangler r2 object put shipeasy-sdk/loader.js --file=dist/loader/loader.global.js --content-type 'application/javascript; charset=utf-8' --cache-control 'public, max-age=300' --remote"
  },
  "dependencies": {
    "murmurhash-js": "^1.0.0"
  },
  "devDependencies": {
    "@types/murmurhash-js": "^1.0.6",
    "@types/node": "^26.0.1",
    "axios": "^1.18.1",
    "jsdom": "^29.1.1",
    "tsup": "^8.3.0",
    "typescript": "^6.0.3",
    "vite": "^6.4.3",
    "vitest": "^4.1.9",
    "wrangler": "^4.83.0"
  },
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "node": ">=20"
  }
}
